{
  "schemaVersion": 1,
  "owner": "provider-substitution-runtime-owner",
  "evidenceClasses": {
    "equivalence": "CATEGORY CAPABILITY EVIDENCE ONLY",
    "browser": "APPROVED BROWSER SUBSTITUTION - ORIGINAL APPLICATION NOT USED",
    "licensedWorker": "LICENSED WORKER EXECUTION CANDIDATE - REAL EVIDENCE REQUIRED",
    "wasm": "SANDBOXED WASM UNIT EXECUTION ONLY",
    "localInference": "LOCAL INFERENCE ROUTE SELECTED - RUNTIME EXECUTION REQUIRED",
    "modelPackage": "SIGNED MODEL PACKAGE VERIFIED - MODEL EXECUTION REQUIRED"
  },
  "equivalents": [
    {
      "category": "cad",
      "adapterId": "freecad",
      "capabilities": ["parametric-cad", "step-export"],
      "formats": ["FCStd", "STEP"]
    },
    {
      "category": "3d",
      "adapterId": "blender",
      "capabilities": ["mesh-edit", "render"],
      "formats": ["blend", "glTF"]
    },
    {
      "category": "fea",
      "adapterId": "calculix",
      "capabilities": ["linear-static", "result-export"],
      "formats": ["inp", "frd"]
    },
    {
      "category": "office",
      "adapterId": "libreoffice",
      "capabilities": ["document-edit", "spreadsheet-edit"],
      "formats": ["odt", "ods", "docx", "xlsx"]
    },
    {
      "category": "image",
      "adapterId": "gimp",
      "capabilities": ["raster-edit", "image-export"],
      "formats": ["xcf", "png"]
    },
    {
      "category": "audio",
      "adapterId": "audacity",
      "capabilities": ["waveform-edit", "audio-export"],
      "formats": ["aup3", "wav"]
    }
  ],
  "substitutionProviders": [
    {
      "id": "local-open-source",
      "route": "local",
      "dataLeavesDevice": false,
      "requiresAccount": false
    },
    {
      "id": "approved-browser",
      "route": "browser",
      "dataLeavesDevice": true,
      "requiresAccount": true
    },
    {
      "id": "licensed-worker",
      "route": "remote-worker",
      "dataLeavesDevice": true,
      "requiresAccount": false
    },
    { "id": "sandboxed-wasm", "route": "wasm", "dataLeavesDevice": false, "requiresAccount": false }
  ],
  "licensedWorker": {
    "signatureRequired": true,
    "localLicenceCheckRequired": true,
    "reusableLicenceSecretAllowed": false,
    "maximumJobMilliseconds": 300000,
    "maximumRetries": 1,
    "protectedFilesAllowed": false,
    "instantRevocationRequired": true
  },
  "wasm": {
    "maximumModuleBytes": 1048576,
    "maximumMemoryPages": 256,
    "maximumExecutionMilliseconds": 5000,
    "networkAllowed": false,
    "undeclaredFilesAllowed": false,
    "deterministicReplayRequired": true
  },
  "localInferenceTiers": [
    {
      "id": "webgpu",
      "priority": 1,
      "minimumMemoryMiB": 4096,
      "requires": ["webgpu", "healthy-driver"]
    },
    {
      "id": "native-gpu",
      "priority": 2,
      "minimumMemoryMiB": 4096,
      "minimumGpuMemoryMiB": 4096,
      "requires": ["native-gpu", "healthy-driver"]
    },
    { "id": "cpu-vector", "priority": 3, "minimumMemoryMiB": 2048, "requires": ["cpu-vector"] },
    { "id": "cpu-micro", "priority": 4, "minimumMemoryMiB": 768, "requires": [] }
  ],
  "modelStore": {
    "signatureRequired": true,
    "bootstrapRequired": true,
    "maximumChunkBytes": 4194304,
    "minimumFreeStorageMiB": 256,
    "resumable": true,
    "rollbackRequired": true,
    "preserveBootstrapOnEviction": true,
    "garbageCollectionRequired": true
  }
}
