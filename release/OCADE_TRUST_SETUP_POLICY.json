{
  "schemaVersion": 1,
  "owner": "trust-and-credential-setup-owner",
  "secureBackends": ["windows-credential-manager", "macos-keychain", "linux-secret-service"],
  "testBackends": ["test-memory-store"],
  "credentials": [
    {
      "capability": "supabase.staging",
      "provider": "supabase",
      "requiredScopes": ["project.read", "database.migrate"],
      "allowedConsumers": ["deployment-controller", "migration-verifier"],
      "setupUrl": "https://supabase.com/dashboard/projects"
    },
    {
      "capability": "ai.inference",
      "provider": "ai-provider",
      "requiredScopes": ["inference.execute"],
      "allowedConsumers": ["ai-gateway"],
      "setupUrl": "https://docs.lovable.dev/features/ai"
    },
    {
      "capability": "cloudflare.deploy",
      "provider": "cloudflare",
      "requiredScopes": ["workers.deploy"],
      "allowedConsumers": ["deployment-controller"],
      "setupUrl": "https://dash.cloudflare.com/profile/api-tokens"
    },
    {
      "capability": "release.sign",
      "provider": "platform-signer",
      "requiredScopes": ["artifact.sign"],
      "allowedConsumers": ["release-orchestrator"],
      "setupUrl": "https://tauri.app/distribute/sign/"
    }
  ],
  "auditFields": [
    "operation",
    "capability",
    "provider",
    "consumer",
    "tenantId",
    "credentialId",
    "keyVersion",
    "outcome",
    "observedAt"
  ],
  "forbiddenAuditFields": ["value", "secret", "token", "credential", "authorization"],
  "selfSignedTrust": {
    "evidenceClass": "EPHEMERAL SELF-SIGNED TEST TRUST ONLY",
    "publicTrustAllowed": false,
    "productionIdentityPresent": false,
    "placeholderProductionKeysAllowed": false
  },
  "signingEligibility": {
    "allowedSpdxLicences": ["Apache-2.0", "MIT", "BSD-2-Clause", "BSD-3-Clause", "MPL-2.0"],
    "communitySigningRequiresPublicSource": true,
    "communitySigningRequiresOwnerApproval": true,
    "communitySigningRequiresReproducibleBuild": true,
    "communitySigningRequiresDependencyNotices": true,
    "proprietaryComponentsAllowedCommunitySigning": false
  },
  "components": [
    {
      "id": "browser-extension",
      "classification": "open_source_candidate",
      "sourceAvailableLocally": true,
      "publicSourceUrl": null,
      "spdxLicence": null,
      "ownerApproved": false,
      "reproducibleBuildCommands": ["npm ci", "npm run test", "npm run build"],
      "dependencyNotices": "release/THIRD_PARTY_NOTICES.md",
      "proprietaryInputs": false,
      "eligibility": "PENDING OWNER LICENCE AND PUBLICATION DECISION"
    },
    {
      "id": "companion-safety-core",
      "classification": "open_source_candidate",
      "sourceAvailableLocally": true,
      "publicSourceUrl": null,
      "spdxLicence": null,
      "ownerApproved": false,
      "reproducibleBuildCommands": [
        "cargo test --all-targets",
        "cargo clippy --all-targets -- -D warnings"
      ],
      "dependencyNotices": "release/THIRD_PARTY_NOTICES.md",
      "proprietaryInputs": false,
      "eligibility": "PENDING OWNER LICENCE AND PUBLICATION DECISION"
    },
    {
      "id": "ocade-product",
      "classification": "proprietary",
      "sourceAvailableLocally": true,
      "publicSourceUrl": null,
      "spdxLicence": null,
      "ownerApproved": false,
      "reproducibleBuildCommands": ["npm ci", "npm run test", "npm run build"],
      "dependencyNotices": "release/THIRD_PARTY_NOTICES.md",
      "proprietaryInputs": true,
      "eligibility": "COMMUNITY OPEN-SOURCE SIGNING PROHIBITED"
    }
  ]
}
