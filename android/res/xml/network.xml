<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere. The one exception is the emulator's view of the developer's
  own computer (10.0.2.2), for the debuggable test build; build.py replaces this
  file in a release build with HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
