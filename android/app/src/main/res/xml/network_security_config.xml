<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for OCADE mobile.

  Cleartext is refused everywhere, including debug builds: pairing material and
  approval traffic must never traverse an unencrypted connection, and a debug
  exception has a habit of surviving into a release.

  No custom trust anchors and no user-added CAs are trusted, so a device with a
  user-installed root certificate cannot silently intercept OCADE traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
