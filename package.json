{
  "name": "carcc-ocade",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <25",
    "npm": ">=10.9.8 <12"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run routes:generate && vite build",
    "build:dev": "npm run routes:generate && vite build --mode development",
    "preview": "wrangler dev --ip 127.0.0.1",
    "routes:generate": "node scripts/generate-routes.mjs",
    "routes:stable": "node scripts/check-generated-stability.mjs routes",
    "build:stable": "node scripts/check-generated-stability.mjs build",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "loc": "node scripts/measure-loc.mjs --by-dir",
    "audit:secrets": "node scripts/scan-bundle-secrets.mjs",
    "a11y:check": "node scripts/check-accessibility.mjs",
    "reachability:check": "node scripts/check-reachability.mjs",
    "reads:check": "node scripts/check-bounded-reads.mjs",
    "controls:check": "node scripts/check-dead-controls.mjs",
    "identity:check": "node scripts/check-model-identity.mjs",
    "content-storage:check": "node scripts/check-content-storage.mjs",
    "monochrome:check": "node scripts/check-monochrome.mjs",
    "supabase:types-check": "node scripts/check-supabase-types.mjs",
    "deploy:check": "node scripts/deploy.mjs --check",
    "deploy:web": "node scripts/deploy.mjs --execute",
    "deploy:rollback": "node scripts/deploy.mjs --rollback",
    "verify:full": "node scripts/verify-full.mjs",
    "audit:shell": "node scripts/e2e/shell-journey.mjs",
    "audit:auth": "node scripts/e2e/auth-journey.mjs",
    "audit:chat": "node scripts/e2e/chat-journey.mjs",
    "audit:online": "node scripts/e2e/online-journey.mjs",
    "audit:offline": "node scripts/e2e/offline-journey.mjs",
    "audit:library": "node scripts/e2e/library-journey.mjs",
    "audit:settings": "node scripts/e2e/settings-journey.mjs",
    "audit:polish": "node scripts/e2e/polish-journey.mjs",
    "audit:final": "node scripts/e2e/final-journey.mjs",
    "stub:supabase": "node scripts/e2e/supabase-stub.mjs",
    "audit:usage": "node scripts/e2e/usage-journey.mjs",
    "audit:jarvis": "node scripts/e2e/jarvis-journey.mjs",
    "audit:browser": "node scripts/e2e/harness.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@wllama/wllama": "^3.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "lightningcss": "1.33.0",
    "nitro": "3.0.260903-beta",
    "playwright-core": "^1.62.1",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "seroval": "1.6.9",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
