[Unit]
Description=OCADE Companion (user session)
# A user unit: it needs the person's graphical session, so it never runs as a system service.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/opt/ocade/ocade-agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/ocade %h/.cache/ocade

[Install]
WantedBy=graphical-session.target
