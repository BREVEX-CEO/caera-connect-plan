{
  "compatibility_date": "2026-08-24",
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ocade-web",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ocade.in/*",
      "zone_name": "ocade.in"
    },
    {
      "pattern": "www.ocade.in/*",
      "zone_name": "ocade.in"
    }
  ],
  "assets": {
    "run_worker_first": true,
    "html_handling": "none",
    "binding": "ASSETS",
    "directory": "../public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "main": "index.mjs",
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ]
}