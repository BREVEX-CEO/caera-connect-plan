{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ubantxggjducfmwoydim.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "caera-foundation-plan",
      "version": "0.1.0",
      "title": "CAERA Foundation Plan"
    },
    "tools": [
      {
        "name": "list_conversations",
        "title": "List OCADE conversations",
        "description": "List the signed-in user's OCADE conversations, newest first, with title, model and privacy mode.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many conversations to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "includeArchived": {
              "default": false,
              "description": "Include archived conversations.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "read_conversation",
        "title": "Read an OCADE conversation",
        "description": "Return the messages of one OCADE conversation owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The conversation id."
            },
            "limit": {
              "default": 50,
              "description": "How many messages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "conversationId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List OCADE projects",
        "description": "List the signed-in user's OCADE projects with their standing instructions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many projects to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "includeArchived": {
              "default": false,
              "description": "Include archived projects.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_project",
        "title": "Create an OCADE project",
        "description": "Create a new OCADE project for the signed-in user, optionally with standing instructions.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Project name."
            },
            "instructions": {
              "description": "Standing instructions OCADE should follow inside this project.",
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "name"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
