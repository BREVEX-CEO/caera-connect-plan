{
  "appId": "com.caeracadane.ocade",
  "appName": "OCADE",
  "webDir": "mobile/www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Preferences": {
      "group": "com.caeracadane.ocade.secure"
    }
  }
}
