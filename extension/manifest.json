{
  "manifest_version": 3,
  "name": "OCADE Cowork",
  "version": "1.0.0",
  "description": "Lets OCADE act in this browser, inside the sites you approve, with pause, stop and take-over always available.",
  "icons": {
    "16": "icons/ocade-16.png",
    "32": "icons/ocade-32.png",
    "48": "icons/ocade-48.png",
    "128": "icons/ocade-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "activeTab"],
  "host_permissions": [],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OCADE Cowork",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/ocade-16.png",
      "32": "icons/ocade-32.png",
      "48": "icons/ocade-48.png",
      "128": "icons/ocade-128.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://ocade.in/*",
      "https://www.ocade.in/*",
      "https://*.lovable.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
