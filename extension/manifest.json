{
  "manifest_version": 3,
  "name": "OCADE JARVIS",
  "short_name": "OCADE",
  "version": "0.1.0",
  "description": "Lets OCADE JARVIS work in tabs it opens in this browser, only when you ask it to and only where you allow it.",
  "homepage_url": "https://ocade.in/ocade-jarvis",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "storage", "alarms"],
  "host_permissions": ["https://ocade.in/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "OCADE JARVIS", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
