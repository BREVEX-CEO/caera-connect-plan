# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Runtime configuration belongs in deployment/local environment stores. Keep a
# documentation-only example in git; never commit environment-specific values.
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated managed-browser sidecars. CI/release builds recreate the
# target-specific executable and Tauri bundles it through externalBin.
.browser-sidecar/
native/companion/tauri/binaries/ocade-browser-host-*
.gesture-sidecar/
native/companion/tauri/binaries/ocade-gesture-host-*
native/companion/tauri/target/
native/companion/tauri/gen/
# The safety crate builds to its own target directory, which this list did not
# cover — so 34 MB of Rust build output sat in `git status` as untracked files
# on every run, buried under the ones a person actually needed to read.
native/companion/safety/target/

# Pytest and Ruff caches. Regenerated by the next run of either tool.
native/python-host/.pytest_cache/
native/python-host/.ruff_cache/

# Python bytecode, ANYWHERE.
#
# The previous rule was scoped to `native/python-host/**`, which left the
# incoming control engine uncovered: the first time anyone runs it, it writes
# `__pycache__` directories that would show up as new files to commit inside a
# directory that is supposed to be held exactly as delivered. Generated
# bytecode is never source, wherever it lands.
__pycache__/
*.py[cod]

# TanStack Router's local build cache.
.tanstack/

# PRIVATE KEY MATERIAL. NEVER COMMITTED, ANYWHERE, FOR ANY REASON.
#
# The incoming control engine ships `config/certs/jarvis.key` — a real private
# key — and the untracked-path classifier caught it on its first run. That
# directory is read-only in this pass, so the key is not being moved or
# deleted; this makes it impossible to commit by accident instead, which is the
# part that would actually be irreversible. Broadened past that one file
# because the next key to arrive will not be called jarvis.key.
*.key
*.pem
*.p12
*.pfx
**/certs/

# The OCADE-owned Python environment. The PINNED REQUIREMENTS are tracked
# (native/python-host/requirements.txt); the installed tree is not — it is
# ~400 MB of platform-specific wheels that setup recreates on each machine.
native/python-host/.venv/
native/python-host/.venv-gesture/
native/python-host/models/
native/python-host/**/__pycache__/

# Licence signing key material — never commit
ocade-licence.*
