# Dependencies, build output and tool caches
node_modules
dist
.output
.output-*
.nitro
.tanstack/
.wrangler/
supabase/.temp/
*.log
*.local

# Local environment values. Only the documented example is tracked.
.env
.env.*
!.env.example
.dev.vars

# Private key material: never committed.
*.key
*.pem
*.p12
*.pfx

# Editors and local agent settings
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
.claude/settings.local.json

# MCP browser snapshots
.playwright-mcp/

# Android build output (python android/build.py)
android/build/
wrangler.e2e.json

# Python bytecode is generated, never source.
__pycache__/
*.pyc

# Optional DeepSeek Harness source intake: extracted archives are local only.
# The incoming ZIP path is intentionally NOT ignored: browser upload is optional.
external/deepseek-harness/unpacked/
external/deepseek-harness/.extract-*/

# Declarations emitted from the pinned DeepSeek submodule (npm run deepseek:types)
src/deepseek/.types/
