<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>OCADE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!--
	  Permission usage descriptions.

	  iOS terminates the app immediately if one of these APIs is used without its
	  description key, so a missing entry is a hard crash rather than a denied
	  prompt. Each string says what OCADE does AND what it will not do.
	-->
	<key>NSCameraUsageDescription</key>
	<string>OCADE uses the camera only when you choose to capture a document or whiteboard to send to your computer. It never records on its own.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>OCADE uses the microphone only while you are speaking to it. It never listens in the background, and it will not capture passwords or one-time codes.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>OCADE opens your photo library only when you pick an image to hand off to your computer.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>OCADE saves an image to your photo library only when you ask it to.</string>

	<!--
	  Face ID / Touch ID is used to confirm a risky action on this device. The
	  system performs the match; OCADE never receives or stores biometric data.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>Confirm with Face ID before approving or stopping something OCADE is doing on your computer.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>OCADE connects to your own computer on your local network to show what it is doing and to let you approve or stop it.</string>

	<!--
	  No arbitrary cleartext loads. Pairing and approval traffic is always TLS.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Uses only standard TLS; declaring this avoids the export-compliance prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Background modes: remote approval alerts only. No background audio or location. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
