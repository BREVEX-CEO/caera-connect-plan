{
  "name": "ocade-web",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [
    { "pattern": "ocade.in/*", "zone_name": "ocade.in" },
    { "pattern": "www.ocade.in/*", "zone_name": "ocade.in" }
  ],
  "assets": {
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
