# Copy to .env.local for local development. Never commit real secrets or
# environment-specific tokens.

# Public account-backend values are supplied by deployment. These are client
# configuration, not privileged secrets.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Online Intelligence provider/model configuration belongs only in the
# server/deployment secret store. Do not put provider keys, provider/model
# identity, endpoints or vendor-specific secrets in VITE_ / PUBLIC_ variables,
# browser bundles, public logs, or source-controlled documentation.

# Signed offline usage authority. Never commit the private key.
# OCADE_LEASE_SIGNING_KEY_ID=
# OCADE_LEASE_SIGNING_PRIVATE_KEY=
# OCADE_LEASE_SIGNING_PUBLIC_KEY=
# OCADE_LEASE_SIGNING_NOT_BEFORE=
# OCADE_LEASE_SIGNING_EXPIRES_AT=
# OCADE_LEASE_PREVIOUS_VERIFICATION_KEYS=[]

# Paid checkout is intentionally closed. Do not add provider-specific payment
# variables until the owner starts a separate paid-checkout mission.
