# Copy to .env.local for local development. Never commit real secrets or
# environment-specific tokens.

# Public Supabase project values are supplied by the deployment environment.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Public readiness attestations only; these are not provider credentials.
# Production builds fail closed when omitted. Set a flag to true only after the
# matching live provider/delivery path has been configured and verified.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_PHONE_ENABLED=false
VITE_AUTH_EMAIL_DELIVERY_READY=false

# Optional cloud inference configuration belongs in the server/deployment secret
# store. Do not prefix server secrets with VITE_ or PUBLIC_.

# Signed offline usage is unavailable until one Ed25519 authority is installed
# in the server secret store. The private key is PKCS8 base64; the public key is
# raw 32-byte base64. Retain prior public keys until every lease they signed has
# expired so an offline device is not stranded during key rotation.
# OCADE_LEASE_SIGNING_KEY_ID=
# OCADE_LEASE_SIGNING_PRIVATE_KEY=
# OCADE_LEASE_SIGNING_PUBLIC_KEY=
# OCADE_LEASE_SIGNING_NOT_BEFORE=
# OCADE_LEASE_SIGNING_EXPIRES_AT=
# OCADE_LEASE_PREVIOUS_VERIFICATION_KEYS=[]

# ---------------------------------------------------------------- payments --
# Checkout availability is DERIVED from these, not from a flag: with any of them
# absent, no checkout is offered anywhere in the product and no payment can be
# started. Set them only once the provider account is genuinely configured.
#
# The client token is public by design — it can open a checkout, never read or
# change an account — which is why it is the only payment value a browser bundle
# may carry. Everything below it is server-side and must never be prefixed with
# VITE_ or PUBLIC_.
# VITE_PAYMENTS_CLIENT_TOKEN=

# One complete pair, sandbox or live. An API key without its webhook secret can
# take money and cannot verify that it was taken, so a half-pair counts as
# unconfigured.
# PAYMENTS_SANDBOX_API_KEY=
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=
# PAYMENTS_LIVE_API_KEY=
# PAYMENTS_LIVE_WEBHOOK_SECRET=

# One product id per sellable plan. A gap here would let somebody reach a
# checkout for a plan the server cannot price.
# OCADE_PRODUCT_ID_PRO_WEEKLY=
# OCADE_PRODUCT_ID_PRO_MONTHLY=
# OCADE_PRODUCT_ID_MAX_WEEKLY=
# OCADE_PRODUCT_ID_MAX_MONTHLY=
