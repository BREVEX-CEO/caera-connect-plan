# Copy to .env.local for local development. Never commit real secrets or
# environment-specific tokens. OCADE is in FREE_LAUNCH_MODE, so payment client
# configuration is intentionally absent.

# Public Supabase project values are supplied by the deployment environment.
# Supabase is used for authentication / optional Private Sync, not AI inference.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Public serving is controlled by an explicit human readiness flag, never a date.
# OCADE_LAUNCH_READY=false
# OCADE_LAUNCH_PREVIEW=false

# OCADE AI IS LOCAL-ONLY.
# Do not add Gemini, GPT/OpenAI, Lovable AI Gateway, or other remote model API
# keys here. The application has no supported server-side AI inference route.
