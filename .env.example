# Copy to .env.local for local development. Never commit real secrets or
# environment-specific tokens. OCADE is in FREE_LAUNCH_MODE, so payment client
# configuration is intentionally absent.

# Public Supabase project values are supplied by the deployment environment.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Public readiness attestations only; these are not provider credentials.
# Production builds fail closed when omitted. Set a flag to true only after the
# matching live provider/delivery path has been configured and verified.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_PHONE_ENABLED=false
VITE_AUTH_EMAIL_DELIVERY_READY=false

# Optional cloud inference configuration belongs in the server/deployment secret
# store. Do not prefix server secrets with VITE_ or PUBLIC_.
