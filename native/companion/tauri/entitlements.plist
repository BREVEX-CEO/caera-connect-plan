<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS entitlements for the CAERA Native Companion.

  Deliberately minimal. The companion performs bounded, user-approved actions on
  the local machine; it does not need network access, camera, microphone, or
  arbitrary file access. Screen recording and accessibility control are granted
  by the USER at first use through the system permission prompts — they are not
  entitlements, and they must never be requested silently.

  Hardened runtime is on and JIT / unsigned memory are NOT allowed.
-->
<plist version="1.0">
  <dict>
    <!-- No inbound or outbound network access from the companion itself. -->
    <key>com.apple.security.network.client</key>
    <false/>
    <key>com.apple.security.network.server</key>
    <false/>

    <!-- Hardened runtime: refuse unsigned executable memory. -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <!-- No capture devices. -->
    <key>com.apple.security.device.camera</key>
    <false/>
    <key>com.apple.security.device.audio-input</key>
    <false/>

    <!--
      User-selected files only. The companion opens what the user has explicitly
      added to the allowlist; it never enumerates the home directory.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Required to send the synthetic input the user has approved. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
