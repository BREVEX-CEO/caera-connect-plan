{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAERA Companion",
  "version": "0.1.0",
  "identifier": "com.caeracadane.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "OCADE Companion",
        "width": 480,
        "height": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "trayIcon": {
      "id": "caera-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "OCADE \u2014 CAERA Companion",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ocade-browser-host",
      "binaries/ocade-gesture-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "CAERA CADANE",
    "category": "Productivity",
    "shortDescription": "OCADE desktop companion",
    "longDescription": "Performs bounded, permission-gated OCADE actions on this computer. Every action is risk-checked, confirmable and auditable, and protected input is always refused.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RjJERDNCOTExM0ZERjEKUldUeC9ST1JPOTN5UlZMbG1jSWR6N2VLVlNkZmU1eWpyUDBHYUFwUUZMaGtlY2xzY05aYXE5cG0K",
      "endpoints": [
        "https://updates.caeracadane.com/companion/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
