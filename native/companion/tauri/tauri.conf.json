{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAERA Companion",
  "version": "0.1.0",
  "identifier": "com.caeracadane.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OCADE",
        "url": "http://localhost:3000/ocade/work",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "OCADE",
        "width": 420,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000; script-src 'self' http://localhost:3000; style-src 'self' 'unsafe-inline' http://localhost:3000; img-src 'self' data: http://localhost:3000; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 http://127.0.0.1:11434",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "trayIcon": {
      "id": "caera-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "OCADE — CAERA Companion",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ocade-browser-host"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "copyright": "CAERA CADANE",
    "category": "Productivity",
    "shortDescription": "OCADE desktop companion",
    "longDescription": "Performs bounded, permission-gated OCADE actions on this computer. Every action is risk-checked, confirmable and auditable, and protected input is always refused.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RjJERDNCOTExM0ZERjEKUldUeC9ST1JPOTN5UlZMbG1jSWR6N2VLVlNkZmU1eWpyUDBHYUFwUUZMaGtlY2xzY05aYXE5cG0K",
      "endpoints": [
        "https://updates.caeracadane.com/companion/{{target}}/{{arch}}/{{current_version}}"
      ]
    },
    "global-shortcut": {
      "all": false
    },
    "clipboard-manager": {
      "all": false
    }
  }
}
